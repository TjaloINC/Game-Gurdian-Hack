-- GameGuardian Lua Script for Bullet Army Run (Fixed & Stable with Menu)

gg.toast("Script Started: Bullet Army Run")

while true do
    -- Main Menu
    local menu = gg.choice({
        "💰 Modify Money / Coins",
        "🚫 Remove Ads",
        "❌ Exit"
    }, nil, "Bullet Army Run - Main Menu")

    if menu == nil then
        gg.toast("Script closed.")
        break
    end

    if menu == 1 then
        -- 1. Prompt user for current money value
        local input = gg.prompt({"Enter your current in-game money/coins (e.g., 349):"}, {"349"}, {"number"})

        if input ~= nil then
            local targetValue = tonumber(input[1])

            -- 2. Search for the exact value
            gg.clearResults()
            gg.searchNumber(targetValue, gg.TYPE_DWORD, false, gg.SIGN_EQUAL, 0, -1)

            local count = gg.getResultsCount()

            if count == 0 then
                gg.alert("No values found! Make sure you entered the exact number currently displayed.")
            else
                -- 3. Prompt user for desired new amount
                local newAmountInput = gg.prompt({"Found " .. count .. " results. Enter your desired new money amount:"}, {"9999999"}, {"number"})
                
                if newAmountInput ~= nil then
                    local newValue = tonumber(newAmountInput[1])
                    
                    -- 4. Get results and modify them using the stable method (gg.setValues)
                    local results = gg.getResults(count)
                    for i, v in ipairs(results) do
                        v.value = newValue
                    end
                    
                    gg.setValues(results)
                    gg.addListItems(results) -- Adds and freezes the items to prevent them from dropping
                    
                    gg.alert("Success! Money modified to " .. newValue .. ". Open the shop or upgrade something to refresh the screen!")
                end
            end
        end

    elseif menu == 2 then
        -- Remove Ads Section
        local adPrompt = gg.prompt({
            "Remove Ads Mode:\n(Most ad flags are 1 = Ads Enabled, 0 = Ads Disabled).\nEnter value to search (usually 1):"
        }, {"1"}, {"number"})

        if adPrompt ~= nil then
            local adTarget = tonumber(adPrompt[1])
            gg.clearResults()
            gg.searchNumber(adTarget, gg.TYPE_DWORD, false, gg.SIGN_EQUAL, 0, -1)
            
            local adCount = gg.getResultsCount()
            if adCount == 0 then
                gg.alert("No values found for ad removal search.")
            else
                local adModify = gg.prompt({
                    "Found " .. adCount .. " results.\nEnter new value to disable ads (usually 0):"
                }, {"0"}, {"number"})
                
                if adModify ~= nil then
                    local adNewVal = tonumber(adModify[1])
                    local adResults = gg.getResults(adCount)
                    for i, v in ipairs(adResults) do
                        v.value = adNewVal
                    end
                    gg.setValues(adResults)
                    gg.addListItems(adResults)
                    gg.alert("Success! Ad flags modified to " .. adNewVal .. ". Restart the game or check if ads are gone!")
                end
            end
        end

    elseif menu == 3 then
        gg.toast("Exiting script. Goodbye!")
        break
    end
end
